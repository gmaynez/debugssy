# Build artifacts
.vscode/**
.vscode-test/**
src/**
out/test/**
.idea/**

# Exclude all out files except the bundled extension.js
out/**
!out/extension.js

# Git and GitHub
.git
.gitignore
.github/**

# Documentation (keep only README.md, LICENSE, CHANGELOG.md in vsix)
docs/**
AGENTS.md
DEBUGSSY_PROMPT.md
CODE_OF_CONDUCT.md
SECURITY.md

# Marketplace preparation (MARKETPLACE.md is swapped to README.md during publish)
MARKETPLACE.md
README.md.backup
MARKETPLACE.md.backup
scripts/prepare-marketplace.js

# Node modules - excluded since we bundle with esbuild
node_modules
**/.eslintrc.json
**/.eslintrc.js

# TypeScript
tsconfig.json
**/*.ts
**/*.d.ts
**/*.map

# Build scripts
esbuild.js

# Example/test files
example/**

# Misc development files
eslint.config.mjs
.editorconfig
.prettierrc
.prettierignore

# Test files
**/test/**
**/*.test.ts
**/*.spec.ts
**/__tests__/**
coverage/**
vitest.config.ts
vitest.config.mts

# Build scripts
*.sh
*.bat

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
