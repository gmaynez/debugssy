{
  "compilerOptions": {
    // Module & Output
    "module": "commonjs", // Required for VS Code extensions
    "target": "ES2022", // Updated: Node.js 22 fully supports ES2022
    "lib": ["ES2022"], // Updated: Match target for consistency
    "outDir": "out",
    "sourceMap": true,
    "rootDir": "src",
    "moduleResolution": "node", // Standard for CommonJS projects (deprecated in TS 6; silenced via ignoreDeprecations below)
    "ignoreDeprecations": "6.0", // TS 6.0: keep CommonJS/"node" resolution until migration to node16/nodenext

    // Type Checking - Strict Mode
    "strict": true, // Enables all strict type checking options

    // Type Checking - Additional Safety (TypeScript 5.x Best Practices)
    "noUncheckedIndexedAccess": true, // Safer array/object property access
    "noImplicitOverride": true, // Require 'override' keyword in subclasses
    "noFallthroughCasesInSwitch": true, // Prevent switch fallthrough bugs
    "noImplicitReturns": true, // Ensure all code paths return a value
    "noUnusedLocals": true, // Report unused local variables
    "noUnusedParameters": true, // Report unused parameters
    "allowUnusedLabels": false, // Disallow unused labels
    "allowUnreachableCode": false, // Error on unreachable code

    // Interoperability & Emit
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, // Skip type checking of declaration files for performance
    "resolveJsonModule": true,

    // Advanced
    "declaration": true, // Generate .d.ts files for better tooling
    "declarationMap": true, // Generate sourcemaps for .d.ts files
    "removeComments": false, // Keep comments in output for debugging
    "newLine": "lf", // Consistent line endings
    "pretty": true // Prettier compiler output
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test", "out", "dist"]
}
