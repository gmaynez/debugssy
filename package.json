{
  "name": "debugssy",
  "displayName": "Debugssy",
  "description": "MCP server for VS Code debugging with tools for breakpoints, debug control, and variable inspection",
  "version": "0.1.0",
  "publisher": "debugssy",
  "author": {
    "name": "Guillermo Garcia Maynez Rocha"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/debugssy.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/debugssy/issues"
  },
  "homepage": "https://github.com/yourusername/debugssy#readme",
  "keywords": [
    "debugging",
    "ai",
    "mcp"
  ],
  "icon": "assets/debugssy_logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Debugssy",
      "properties": {
        "debugssy.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the MCP server for debugging tools"
        },
        "debugssy.mcp.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the MCP server to listen on (localhost only)"
        },
        "debugssy.automationLevel": {
          "type": "string",
          "enum": [
            "assisted",
            "full"
          ],
          "default": "assisted",
          "description": "Control automation level: 'assisted' (user controls flow, AI assists) or 'full' (AI has full control)",
          "enumDescriptions": [
            "Assisted mode: AI can set breakpoints and inspect, but user controls execution flow via VS Code UI",
            "Full mode: AI has complete control over debugging session including starting, stopping, and stepping"
          ]
        },
        "debugssy.waitForBreakpointTimeout": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Default timeout in milliseconds for wait_for_breakpoint tool (1s to 5min, default: 10s). Can be overridden per-call."
        }
      }
    },
    "commands": [
      {
        "command": "debugssy.startServer",
        "title": "Debugssy: Start Server"
      },
      {
        "command": "debugssy.stopServer",
        "title": "Debugssy: Stop Server"
      },
      {
        "command": "debugssy.restartServer",
        "title": "Debugssy: Restart Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "typescript": "^5.3.2",
    "@vscode/vsce": "^3.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.1.0"
  }
}