{
  "name": "debugssy",
  "displayName": "Debugssy",
  "description": "MCP server for VS Code debugging with tools for breakpoints, debug control, and variable inspection",
  "version": "1.1.2",
  "publisher": "gamag",
  "author": {
    "name": "Guillermo Garcia Maynez Rocha"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmaynez/debugssy.git"
  },
  "bugs": {
    "url": "https://github.com/gmaynez/debugssy/issues"
  },
  "homepage": "https://github.com/gmaynez/debugssy#readme",
  "keywords": [
    "debugging",
    "ai",
    "mcp"
  ],
  "icon": "assets/debugssy_logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Debugssy",
      "properties": {
        "debugssy.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the MCP server for debugging tools"
        },
        "debugssy.mcp.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the MCP server to listen on (localhost only)"
        },
        "debugssy.automationLevel": {
          "type": "string",
          "enum": [
            "assisted",
            "full"
          ],
          "default": "assisted",
          "description": "Control automation level: 'assisted' (user controls flow, AI assists) or 'full' (AI has full control)",
          "enumDescriptions": [
            "Assisted mode: AI can set breakpoints and inspect, but user controls execution flow via VS Code UI",
            "Full mode: AI has complete control over debugging session including starting, stopping, and stepping"
          ]
        },
        "debugssy.waitForBreakpointTimeout": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Default timeout in milliseconds for wait_for_breakpoint tool (1s to 5min, default: 5s). Can be overridden per-call."
        },
        "debugssy.allowStepOperations": {
          "type": "boolean",
          "default": false,
          "description": "Enable step operations (step_over, step_into, step_out) in full automation mode. Note: For AI debugging, setting strategic breakpoints and using 'continue' is generally more efficient."
        }
      }
    },
    "commands": [
      {
        "command": "debugssy.startServer",
        "title": "Debugssy: Start Server"
      },
      {
        "command": "debugssy.stopServer",
        "title": "Debugssy: Stop Server"
      },
      {
        "command": "debugssy.restartServer",
        "title": "Debugssy: Restart Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-extension",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-extension": "npm run check-types && node esbuild.js --production",
    "pretest": "npm run compile",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.6",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  }
}
